---
/**
 * Galeria de aplicações — fase "prova" da biblioteca B2, no visual COAIR.
 *
 * Fundo industrial escuro em largura total, cabeçalho centrado e 4 cards-botão: a foto do
 * compressor num palco branco e, abaixo, o ícone verde, o nome da marca, o texto e a seta. O card inteiro é o CTA, por isso o `<button>` envolve a foto e o texto.
 */
import { Image } from 'astro:assets'
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import SectionHeader from '@components/SectionHeader.astro'
import type { SectionProps } from '@lib/layout'
import { applications } from '@data/sections/aplicacoes'

type Props = SectionProps

const { tone, rhythm } = Astro.props
---

<Section
  id="aplicacoes"
  tone={tone}
  rhythm={rhythm}
  container={false}
  class="relative isolate overflow-hidden py-(--section-gap)!"
>
  {/* COAIR: bloco navy com o respiro único entre seções (global.css) da borda ao conteúdo,
      em cima e embaixo, no lugar do ritmo da composição */}
  <div aria-hidden="true" class="apps-bg pointer-events-none absolute inset-0 -z-10"></div>

  <div class="mx-auto max-w-page px-6 lg:px-10">
    <SectionHeader
      eyebrow={applications.eyebrow}
      title={applications.title}
      text={applications.text}
      align="center"
      width="full"
      tone="light"
      accent="green"
    />

    <ul class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
      {applications.items.map((app) => (
        <li>
          <button
            type="button"
            data-cta={`aplicacoes-${app.id}`}
            class="btn-slave-whats app-card group relative flex h-full w-full flex-col overflow-hidden rounded-[10px] text-left transition-[transform,box-shadow] duration-300 ease-out hover:-translate-y-1.5 hover:shadow-[0_28px_56px_-28px_rgba(0,0,0,0.9)]"
          >
            {/* Foto do compressor (fundo branco) num palco claro */}
            <div class="relative m-2.5 aspect-[4/3] overflow-hidden rounded-md bg-neutral-light">
              <Image
                src={app.photo.src}
                alt={app.photo.alt}
                format="webp"
                width={640}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-contain object-center transition-transform duration-500 ease-out group-hover:scale-[1.05]"
              />
            </div>

            {/* Ícone, marca e seta numa linha; a descrição embaixo, na largura do card */}
            <div class="relative flex flex-1 flex-col gap-3 px-5 pt-3 pb-5">
              <span class="flex items-center gap-3.5">
                <span class="flex size-11 shrink-0 items-center justify-center rounded-md bg-brand-green text-neutral-light shadow-[0_10px_24px_-10px_rgb(63_220_90/0.7)]">
                  <Icon name={app.icon} class="size-6" />
                </span>
                <span class="min-w-0 flex-1 font-display text-lg leading-tight font-extrabold text-neutral-light">
                  {app.label}
                </span>
                <span class="flex size-10 shrink-0 items-center justify-center rounded-full border-[1.5px] border-[#b2c3dc]/75 text-neutral-light transition-[background-color,border-color,color,transform] duration-300 group-hover:translate-x-0.5 group-hover:border-brand-green group-hover:bg-brand-green group-hover:text-primary-dark-900">
                  <Icon name="arrow-right" class="size-4" />
                </span>
              </span>
              {/* Até 38ch: a descrição fica em 2 linhas mesmo nos cards largos (2 colunas) */}
              <span class="block max-w-[38ch] font-sans text-[13px] leading-relaxed text-[#b4c6d9]">
                {app.description}
              </span>
            </div>
          </button>
        </li>
      ))}
    </ul>
  </div>
</Section>

<style>
  /* Fundo de galpão escuro: luzes do teto nos cantos, colunas sutis e reflexo do piso. */
  .apps-bg {
    background:
      radial-gradient(34% 26% at 6% 0%, rgb(64 140 205 / 0.42), transparent 70%),
      radial-gradient(30% 24% at 94% 2%, rgb(64 140 205 / 0.36), transparent 70%),
      radial-gradient(60% 28% at 50% 100%, rgb(30 80 120 / 0.32), transparent 70%),
      repeating-linear-gradient(90deg, transparent 0 136px, rgb(120 170 210 / 0.035) 136px 140px),
      linear-gradient(to bottom, #062036, #00121f 40%, #00121f 75%, #021a2b);
  }

  /* Contorno azulado, mais claro no topo; verde no hover. */
  .app-card {
    border: 1px solid transparent;
    background:
      linear-gradient(#03121e, #03121e) padding-box,
      linear-gradient(
          to bottom,
          rgb(120 196 236 / 0.7),
          rgb(40 120 165 / 0.4) 55%,
          rgb(20 90 130 / 0.55)
        )
        border-box;
  }

  .app-card:hover,
  .app-card:focus-visible {
    background:
      linear-gradient(#03121e, #03121e) padding-box,
      linear-gradient(to bottom, rgb(63 220 90 / 0.9), rgb(63 220 90 / 0.3)) border-box;
  }

  @media (prefers-reduced-motion: reduce) {
    .app-card,
    .app-card * {
      transition: none !important;
    }

    .app-card:hover {
      transform: none;
    }
  }
</style>
