---
/**
 * Diferenciais — fase "autoridade" da biblioteca B2.
 *
 * Bloco navy em largura total (por isso `container={false}`) com 5 cards
 * sobrepostos à sua base. É a segunda seção que carrega bloco navy: o respiro
 * escuro da segunda metade, imediatamente antes da conversão.
 */
import { Picture, Image } from 'astro:assets'
import logo from '../../assets/LOGO.png'
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import Button from '@components/Button.astro'
import Eyebrow from '@components/Eyebrow.astro'
import type { SectionProps } from '@lib/layout'
import { cta } from '@data/content'
import { why } from '@data/sections/diferenciais'
import { site } from '@data/site'

type Props = SectionProps

const { tone, rhythm } = Astro.props
---

{/* COAIR: sem respiro no topo, o bloco navy encosta reto no fundo escuro da galeria, nem
    embaixo: o vão até a cotação é o respiro único entre seções (global.css), que vem dela.
    `data-why` é a raiz que o script das setas procura (sem ele as setas não funcionavam). */}
<Section
  id="diferenciais"
  tone={tone}
  rhythm={rhythm}
  container={false}
  class="relative pt-0! pb-0!"
  data-why
>
  {/* Bloco navy em largura total */}
  <div class="why-hero navy-premium relative flex flex-col overflow-hidden">
    <span aria-hidden="true" class="why-grid pointer-events-none absolute inset-0"></span>

    {/* Foto de cenário sangrando à direita (desktop) e abaixo do texto (mobile) */}
    <div class="relative order-2 h-[340px] w-full sm:h-[420px] lg:absolute lg:inset-y-0 lg:right-0 lg:order-none lg:h-auto lg:w-[82%]">
      <Picture
        src={why.scene.src}
        alt={why.scene.alt}
        widths={[640, 1024, 1672]}
        sizes="(min-width: 1024px) 82vw, 100vw"
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        loading="lazy"
        decoding="async"
        class="absolute inset-0 h-full w-full object-cover object-[78%_30%] lg:object-[100%_50%]"
        pictureAttributes={{ class: 'absolute inset-0 h-full w-full' }}
      />
      <span
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_bottom,var(--color-primary-dark)_0%,transparent_30%)] lg:bg-[linear-gradient(to_right,var(--color-primary-dark)_0%,var(--color-primary-dark)_28%,transparent_52%)]"
      ></span>
      <span
        aria-hidden="true"
        class="pointer-events-none absolute inset-x-0 bottom-0 hidden h-1/4 bg-gradient-to-t from-primary-dark-900/50 to-transparent lg:block"
      ></span>
    </div>

    <div class="relative order-1 mx-auto w-full max-w-page px-6 pt-(--section-gap) pb-8 lg:px-10 lg:pb-24">
      <span
        aria-hidden="true"
        class="pointer-events-none absolute top-5 left-6 hidden size-[18px] border-t-2 border-l-2 border-accent-orange opacity-90 lg:top-8 lg:left-10 lg:block"
      ></span>
      <div class="max-w-xl lg:max-w-[50%]">
        <Eyebrow tone="light">{why.eyebrow}</Eyebrow>
        <h2 class="mt-3 font-display text-[28px] leading-[1.15] font-extrabold text-neutral-light sm:text-[32px] xl:text-[36px]">
          {/* Uma linha por bloco (e não <br>), para o balance do título funcionar em cada
              uma; a logo fica dentro da última, colada ao texto */}
          {why.titleLines.map((line, i) => (
            <span class="block">
              {line}
              {why.titleLogo && i === why.titleLines.length - 1 && (
                <Image
                  src={logo}
                  alt={site.brandShort}
                  width={276}
                  height={92}
                  format="webp"
                  loading="lazy"
                  decoding="async"
                  class="ml-3 inline-block h-[1.15em] w-auto align-[-0.18em]"
                />
              )}
            </span>
          ))}
        </h2>

        <span aria-hidden="true" class="mt-5 block h-[3px] w-16 bg-accent-orange"></span>

        {/* `\n` no texto vira linha própria a partir de xl; abaixo, o texto quebra sozinho */}
        <p class="mt-5 font-sans text-[15px] leading-relaxed text-neutral-light/75 sm:text-base">
          {why.text.split('\n').map((line, i) => (
            <>
              {i > 0 && ' '}
              <span class="xl:block">{line}</span>
            </>
          ))}
        </p>

        <Button cta="diferenciais-cta" variant="brand" class="mt-7">
          {cta.primary}
        </Button>
      </div>
    </div>
  </div>

  {/* Cards sobrepostos à base do bloco navy: trilho com setas até 1280px, grade de 5 a partir
      daí (em 5 colunas abaixo disso as descrições passam de 3 linhas) */}
  <div class="relative z-10 mx-auto -mt-16 max-w-page px-6 lg:px-10">
    <ul
      class="why-track scroll-track -mx-6 flex snap-x snap-mandatory scroll-px-6 gap-4 overflow-x-auto px-6 pb-3 lg:-mx-10 lg:scroll-px-10 lg:px-10 xl:mx-0 xl:grid xl:grid-cols-5 xl:gap-4 xl:overflow-visible xl:px-0 xl:pb-0"
      aria-label={why.eyebrow}
    >
      {why.reasons.map((reason) => (
        <li class="why-card group relative flex w-[78%] shrink-0 snap-start flex-col gap-2.5 overflow-hidden rounded-2xl border border-neutral-gray-200/70 bg-neutral-light p-4 shadow-[0_24px_48px_-24px_rgba(0,24,48,0.45)] transition-[transform,box-shadow,border-color] duration-300 ease-out hover:-translate-y-1.5 hover:border-accent-orange/50 hover:shadow-[0_32px_60px_-28px_rgba(0,33,71,0.5)] sm:w-[44%] lg:w-[30%] xl:w-auto">
          <span
            aria-hidden="true"
            class="absolute inset-x-0 top-0 h-[3px] origin-left scale-x-0 bg-accent-orange transition-transform duration-300 ease-out group-hover:scale-x-100"
          />
          <div class="flex items-center gap-2">
            <span class="icon-duo flex size-10 shrink-0 items-center justify-center rounded-xl bg-neutral-gray-100 text-primary-dark-800 transition-colors duration-300 group-hover:bg-accent-orange/10 group-hover:text-accent-orange">
              <Icon name={reason.icon} class="size-7 [stroke-width:2]" />
            </span>
            <h3 class="line-clamp-2 flex min-h-[2.5em] items-center font-display text-[15px] leading-[1.25] font-extrabold text-ink">
              {reason.title}
            </h3>
          </div>
          <p class="font-sans text-[13px] leading-relaxed text-ink-soft">{reason.description}</p>
        </li>
      ))}
    </ul>

    <div class="mt-3 flex items-center justify-center gap-3 xl:hidden">
      <button
        type="button"
        data-why-prev
        aria-label="Diferencial anterior"
        class="flex size-10 items-center justify-center rounded-full border border-neutral-gray-200 bg-neutral-light text-primary-dark transition-colors hover:border-accent-orange hover:text-accent-orange"
      >
        <Icon name="chevron-right" class="size-4 rotate-180" />
      </button>
      <button
        type="button"
        data-why-next
        aria-label="Próximo diferencial"
        class="flex size-10 items-center justify-center rounded-full border border-neutral-gray-200 bg-neutral-light text-primary-dark transition-colors hover:border-accent-orange hover:text-accent-orange"
      >
        <Icon name="chevron-right" class="size-4" />
      </button>
    </div>
  </div>
</Section>

<style>
  .why-hero {
    isolation: isolate;
  }
  @media (min-width: 1024px) {
    .why-hero {
      display: flex;
      align-items: center;
      min-height: 520px;
    }
  }

  .why-grid {
    background-image:
      linear-gradient(rgb(255 255 255 / 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.05) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: radial-gradient(ellipse at 15% 10%, black 0%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse at 15% 10%, black 0%, transparent 70%);
  }

  @media (prefers-reduced-motion: reduce) {
    .why-card,
    .why-card * {
      transition: none !important;
    }

    .why-card:hover {
      transform: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-why]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.why-track')
    const prev = root.querySelector<HTMLButtonElement>('[data-why-prev]')
    const next = root.querySelector<HTMLButtonElement>('[data-why-next]')
    if (!track || !prev || !next) return

    const step = () => {
      const card = track.querySelector<HTMLElement>('li')
      return card ? card.offsetWidth + 16 : track.clientWidth * 0.8
    }

    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }))
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }))
  })
</script>
