---
/**
 * Vitrine — fase "oferta", no formato "Por que escolher nosso serviço de locação?".
 *
 * COAIR Locação: cabeçalho à esquerda, foto da frota num palco branco e 4 vantagens em
 * cards azul-marinho com ícone verde. Partiu do modelo do cliente (2 cards ao lado da foto,
 * 2 abaixo); em 13/10/2026 as 4 vantagens passaram a uma coluna ao lado da foto, todas da
 * mesma altura e fechando com ela em cima e embaixo — no 2 + 2, os cards ao lado da foto
 * esticavam até a altura dela e ficavam vazios, e os de baixo, baixos. Mantém o id
 * `vitrine` e o nome do componente da composição.
 */
import { Image } from 'astro:assets'
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import SectionHeader from '@components/SectionHeader.astro'
import type { SectionProps } from '@lib/layout'
import { showcase } from '@data/sections/vitrine'

type Props = SectionProps

const { tone, rhythm } = Astro.props
---

<Section
  id="vitrine"
  tone={tone}
  rhythm={rhythm}
  container={false}
  class="relative isolate overflow-hidden pt-(--section-gap)! pb-[calc(var(--section-gap)/2)]!"
>
  {/* COAIR: respiro único entre seções (global.css) no lugar do ritmo da composição. O vão
      até o painel do identificar fica metade aqui, metade lá. */}
  <div aria-hidden="true" class="vitrine-bg pointer-events-none absolute inset-0 -z-10"></div>

  <div class="mx-auto max-w-page px-6 lg:px-10">
    <SectionHeader
      eyebrow={showcase.eyebrow}
      title={showcase.title}
      text={showcase.text}
      width="full"
      accent="green"
      shape="dash"
    />

    <div class="mt-8 grid gap-4 lg:grid-cols-2 lg:gap-12">
      {/* Frota COAIR recortada (fundo transparente) direto sobre o fundo da seção, sem caixa
          nem margem (13/10/2026). É ela que dá a altura do bloco: os cards ao lado se dividem
          nessa altura (a partir de 1430px batem exatamente; abaixo disso, se os cards
          precisarem de mais altura, a imagem fica centrada) */}
      <div class="flex items-center">
        <Image
          src={showcase.photo.src}
          alt={showcase.photo.alt}
          format="webp"
          widths={[480, 800, 1200]}
          sizes="(min-width: 1430px) 651px, (min-width: 1024px) 45vw, 100vw"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-contain"
        />
      </div>

      {/* 4 vantagens em coluna, todas com a mesma altura, dividindo a altura da imagem */}
      <ul class="grid gap-3 lg:grid-rows-4">
        {showcase.items.map((item) => (
          <li>
            <button
              type="button"
              data-cta={`vitrine-${item.id}`}
              class="btn-slave-whats benefit-card h-full w-full text-left"
            >
              <span class="benefit-icon">
                <Icon name={item.icon} class="size-6" />
              </span>
              <span class="flex flex-col gap-1">
                <span class="font-display text-lg leading-tight font-extrabold text-neutral-light">
                  {item.title}
                </span>
                <span class="font-sans text-sm leading-snug text-neutral-light/75">
                  {item.description}
                </span>
              </span>
            </button>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Section>

<style>
  /* Cinza-claro da página com faixas de luz diagonais, bem suaves. */
  .vitrine-bg {
    background:
      linear-gradient(118deg, transparent 58%, rgb(255 255 255 / 0.7) 63% 68%, transparent 73%),
      linear-gradient(118deg, transparent 77%, rgb(255 255 255 / 0.55) 80% 83%, transparent 86%),
      linear-gradient(118deg, rgb(255 255 255 / 0.6) 0 6%, transparent 12%),
      var(--color-neutral-gray-100);
  }

  .benefit-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    /* Respiro vertical curto: o card estica até 1/4 da altura da imagem ao lado. */
    padding: 0.75rem 1.5rem;
    border-radius: 0.75rem;
    border-bottom: 3px solid var(--color-brand-green);
    background-image: linear-gradient(
      135deg,
      var(--color-primary-dark-800),
      var(--color-primary-dark) 60%,
      var(--color-primary-dark-900)
    );
    box-shadow: 0 14px 30px -18px rgb(0 24 48 / 0.6);
    transition: transform 260ms ease;
  }

  .benefit-card:hover {
    transform: translateY(-3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .benefit-card {
      transition: none;
    }

    .benefit-card:hover {
      transform: none;
    }
  }

  .benefit-icon {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 0.5rem;
    background-color: var(--color-brand-green);
    color: var(--color-primary-dark-900);
  }
</style>
