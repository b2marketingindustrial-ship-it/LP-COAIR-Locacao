---
/**
 * Vitrine — fase "oferta", no formato "Por que escolher nosso serviço de locação?".
 *
 * COAIR Locação: cabeçalho à esquerda, foto da frota num palco branco e 4 vantagens em
 * cards azul-marinho com ícone verde (2 ao lado da foto, 2 abaixo), no modelo enviado
 * pelo cliente. Mantém o id `vitrine` e o nome do componente da composição.
 */
import { Image } from 'astro:assets'
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import SectionHeader from '@components/SectionHeader.astro'
import type { SectionProps } from '@lib/layout'
import { showcase } from '@data/sections/vitrine'

type Props = SectionProps

const { tone, rhythm } = Astro.props
---

<Section
  id="vitrine"
  tone={tone}
  rhythm={rhythm}
  container={false}
  class="relative isolate overflow-hidden"
>
  <div aria-hidden="true" class="vitrine-bg pointer-events-none absolute inset-0 -z-10"></div>

  <div class="mx-auto max-w-[1152px] px-6 lg:px-10">
    <SectionHeader
      eyebrow={showcase.eyebrow}
      title={showcase.title}
      text={showcase.text}
      width="2xl"
      accent="green"
      shape="dash"
    />

    <div class="mt-8 grid gap-4 lg:grid-cols-2 lg:gap-5">
      {/* Foto da frota COAIR; os 2 primeiros cards ficam ao lado dela e os outros 2 abaixo */}
      <div class="overflow-hidden rounded-xl bg-neutral-light shadow-[0_1px_2px_rgba(16,24,40,0.04),0_10px_24px_-14px_rgba(16,24,40,0.2)] lg:row-span-2">
        <Image
          src={showcase.photo.src}
          alt={showcase.photo.alt}
          format="webp"
          widths={[480, 800, 1200]}
          sizes="(min-width: 1024px) 536px, 100vw"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-contain"
        />
      </div>

      {showcase.items.map((item) => (
        <button
          type="button"
          data-cta={`vitrine-${item.id}`}
          class="btn-slave-whats benefit-card text-left"
        >
          <span class="benefit-icon">
            <Icon name={item.icon} class="size-6" />
          </span>
          <span class="flex flex-col gap-1">
            <span class="font-display text-lg leading-tight font-extrabold text-neutral-light">
              {item.title}
            </span>
            <span class="font-sans text-sm leading-relaxed text-neutral-light/75">
              {item.description}
            </span>
          </span>
        </button>
      ))}
    </div>
  </div>
</Section>

<style>
  /* Cinza-claro da página com faixas de luz diagonais, bem suaves. */
  .vitrine-bg {
    background:
      linear-gradient(118deg, transparent 58%, rgb(255 255 255 / 0.7) 63% 68%, transparent 73%),
      linear-gradient(118deg, transparent 77%, rgb(255 255 255 / 0.55) 80% 83%, transparent 86%),
      linear-gradient(118deg, rgb(255 255 255 / 0.6) 0 6%, transparent 12%),
      var(--color-neutral-gray-100);
  }

  .benefit-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    border-radius: 0.75rem;
    border-bottom: 3px solid var(--color-brand-green);
    background-image: linear-gradient(
      135deg,
      var(--color-primary-dark-800),
      var(--color-primary-dark) 60%,
      var(--color-primary-dark-900)
    );
    box-shadow: 0 14px 30px -18px rgb(0 24 48 / 0.6);
    transition: transform 260ms ease;
  }

  .benefit-card:hover {
    transform: translateY(-3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .benefit-card {
      transition: none;
    }

    .benefit-card:hover {
      transform: none;
    }
  }

  .benefit-icon {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 0.5rem;
    background-color: var(--color-brand-green);
    color: var(--color-primary-dark-900);
  }
</style>
